# —— 只读 API（pnpm start / pnpm dev）——
PORT=4100
DB_HOST=127.0.0.1
DB_NAME=darkforest_leaderboard
DB_USER=root
DB_PASSWORD=password
# DB_PORT=3306

# —— 排行榜投影（pnpm project），从 sqlite-indexer 读取排行榜快照 ——
# INDEXER_URL=http://127.0.0.1:3101
# World 默认从 ../contracts/worlds.json 读（WORLD_CHAIN_ID，BSC 用 56）。
# WORLD_CHAIN_ID=56
# WORLD_ADDRESS=0x...
# INITIAL_BLOCK_NUMBER=135405573
#
# 清榜重刷（默认不执行）：pnpm project:reset
# 必须在交互终端输入 RESET；常驻 project 不会自动 reset。
