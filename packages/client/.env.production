# Cloudflare Pages / production build for starlinkdf.tagai.fun
VITE_NODE_ENV=production
VITE_CHAIN_ID=56
VITE_API_BASE_URL=https://sldf-api.tagai.fun
VITE_DEFAULT_RPC=https://bsc-dataseed1.bnbchain.org
# MUD store-sync indexer (HTTP). Required for fast first load on BSC.
# Do not point this at sldf-api — that is the leaderboard Express API.
# After packages/indexer is public, set and redeploy client, e.g.:
# VITE_INDEXER_URL=https://sldf-indexer.tagai.fun
VITE_INDEXER_URL=
VITE_AI_API_URL=https://sldf-api.tagai.fun
