# BSC MUD store-indexer (sqlite). Copy to .env and fill before starting.
# Client sync uses this HTTP API via VITE_INDEXER_URL (not the leaderboard Express API).

RPC_HTTP_URL=https://bsc.publicnode.com
# Optional but recommended when available:
# RPC_WS_URL=wss://bsc.publicnode.com

# World deploy block from contracts/worlds.json["56"]
START_BLOCK=135405573
STORE_ADDRESS=0xfaD1cDDAD97113e4c0335FF5A815955c21b2ddca

# Public BSC RPC often rejects large eth_getLogs; keep this modest.
MAX_BLOCK_RANGE=500
FOLLOW_BLOCK_TAG=latest
POLLING_INTERVAL=2000

HOST=0.0.0.0
PORT=3001
SQLITE_FILENAME=./data/bsc-indexer.db

# —— 排行榜投影（./start-project.sh）写入 MySQL，只读 API 再读库 ——
# DB_HOST=127.0.0.1
# DB_NAME=darkforest_leaderboard
# DB_USER=root
# DB_PASSWORD=password
# DB_PORT=3306
# INDEXER_URL 默认 http://127.0.0.1:$PORT；投影从这个地址读排行榜快照。
# WORLD_CHAIN_ID=56
